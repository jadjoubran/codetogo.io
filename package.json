{
  "name": "codetogo",
  "private": false,
  "devDependencies": {
    "@astrojs/markdown-satteri": "^0.4.3",
    "algoliasearch": "^3.35.1",
    "astro": "^7.3.8",
    "husky": "^0.14.3",
    "lint-staged": "^15.2.7",
    "prettier": "^1.19.1",
    "sass": "^1.26.10",
    "yaml-front-matter": "^4.1.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "sync": "node tasks/algolia-sync.js",
    "precommit": "lint-staged",
    "netlify-build": "npm run build && npm run sync"
  },
  "lint-staged": {
    "source/_jsusecases/*.md": [
      "prettier --write",
      "git add"
    ],
    "source/_reactusecases/*.md": [
      "prettier --write",
      "git add"
    ]
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
